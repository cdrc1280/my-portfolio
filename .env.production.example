# Production settings for the Oracle Cloud server. Copy to .env on the server and fill in every
# value marked CHANGE. Never commit the real .env. See docs/operations/oracle-cloud.md.

APP_NAME="Cedric James Leala"
APP_ENV=production
# generated by scripts/deploy.sh on the first run
APP_KEY=
APP_DEBUG=false
# your domain, with https://
APP_URL=https://CHANGE.duckdns.org
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Domain Caddy requests the HTTPS certificate for (no https://).
DOMAIN=CHANGE.duckdns.org

# visible with: docker compose -f docker-compose.prod.yml logs app
LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=portfolio
DB_USERNAME=portfolio
DB_PASSWORD=CHANGE-long-random-password
DB_ROOT_PASSWORD=CHANGE-another-long-random-password

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true

FILESYSTEM_DISK=local
MEDIA_DISK=public
QUEUE_CONNECTION=redis
CACHE_STORE=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Outgoing mail (contact-form notification + auto-reply). Free option: a Gmail "app password"
# (Google Account → Security → 2-Step Verification → App passwords).
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=CHANGE@gmail.com
MAIL_PASSWORD=CHANGE-16-character-app-password
MAIL_FROM_ADDRESS=CHANGE@gmail.com
MAIL_FROM_NAME="${APP_NAME}"
CONTACT_NOTIFICATION_EMAIL=CHANGE@gmail.com

VITE_APP_NAME="${APP_NAME}"

# The admin login the seeder creates on the first deploy. Use a strong, unique password.
ADMIN_NAME="Cedric James Leala"
ADMIN_EMAIL=CHANGE@example.com
ADMIN_PASSWORD=CHANGE-strong-password

GITHUB_USERNAME=cdrc1280
GITHUB_TOKEN=
CALENDLY_TOKEN=

# Cookie-free analytics (optional): umami | plausible, empty = off.
ANALYTICS_PROVIDER=
ANALYTICS_SITE_ID=
ANALYTICS_SCRIPT_URL=
