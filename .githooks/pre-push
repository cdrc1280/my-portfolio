#!/usr/bin/env sh
# Runs the Pest suite inside the app container before every push; a failing test blocks the push.
# Enable once per clone with `make hooks` (or scripts/setup-git-hooks.sh). Skip once with `git push --no-verify`.
set -e

echo "pre-push: running the test suite in Docker…"

if ! docker compose run --rm --no-deps -u www-data app php artisan test --parallel; then
    echo "pre-push: tests failed, push aborted." >&2
    exit 1
fi
