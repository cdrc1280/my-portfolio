# FrankenPHP on Vercel: Vercel terminates HTTPS and forwards plain HTTP to $PORT.
{
	frankenphp
	admin off
}

:{$PORT:80} {
	root * /app/public
	encode zstd gzip

	# Fingerprinted build assets never change.
	@build path /build/*
	header @build Cache-Control "public, max-age=31536000, immutable"

	php_server {
		try_files {path} index.php
	}
}
